<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PERMISSIONS — deliberately minimal.

      * FINE + COARSE location, FOREGROUND ONLY. No ACCESS_BACKGROUND_LOCATION:
        the app is useless in the background and background location triggers a
        heavy Play review. Requested at runtime with a rationale screen.
      * No INTERNET permission in v1. The app never phones home: location stays
        on the device. Adding AdMob later requires adding INTERNET +
        ACCESS_NETWORK_STATE here — see docs/MONETIZATION.md.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Normal permission, no runtime prompt. Used only for the short "tick"
         when the heading crosses a cardinal point (can be turned off in
         Options). Compose's performHapticFeedback() is too unreliable for
         this — many OEMs mute it unless "touch feedback" is on, even with
         general vibration enabled — so we drive the Vibrator directly. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Hardware is used when present but not required, so GPS-only tablets and
         compass-less devices can still install and use the parts that work. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:name=".NorteiaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Norteia.Starting"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Norteia.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
