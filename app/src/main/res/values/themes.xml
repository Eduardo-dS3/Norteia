<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Launch theme: shows the splash, then hands off to the Compose UI. -->
    <style name="Theme.Norteia.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Norteia</item>
    </style>

    <!-- App theme. Always dark by design; Compose paints everything above it. -->
    <style name="Theme.Norteia" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
    </style>

</resources>
